{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": false,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/types/*": ["types/*"],
			"@/enums/*": ["enums/*"],
			"@/schemas/*": ["schemas/*"]
		}
	},
	"include": ["types/**/*.ts", "enums/**/*.ts", "schemas/**/*.ts", "constants/**/*.ts"]
}
