{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": false,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "react-jsx"
	},
	"include": ["types/**/*.ts", "enums/**/*.ts", "schemas/**/*.ts", "constants/**/*.ts"]
}
