{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": "./",
		"paths": {
			"@/*": ["src/*"] // Mapowanie: @/coś zamienia na src/coś
		} // Baza projektowa (zazwyczaj katalog główny)
	}
}
