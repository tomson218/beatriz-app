{
	"name": "beatriz-app",
	"private": true,
	"workspaces": [
		"backend",
		"frontend",
		"shared"
	],
	"scripts": {
		"dev:frontend": "npm --workspace frontend run dev",
		"dev:backend": "npm --workspace backend run start",
		"build:frontend": "npm --workspace frontend run build",
		"typecheck": "npm --workspace frontend run build",
		"test": "vitest run",
		"test:coverage": "npm --workspace backend run test:coverage && npm --workspace frontend run test:coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.3.3"
	}
}
